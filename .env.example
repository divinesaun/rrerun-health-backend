# Database
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OCR
OCRSPACE_API_KEY=helloworld

# OpenRouter (Step 3.5 Flash)
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
STEPFUN_MODEL=stepfun/step-3.5-flash:free

# JWT for Pharmacy Dashboard
JWT_SECRET_KEY=your-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Admin Account (seeded on startup)
ADMIN_EMAIL=admin@rerun.health
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_NAME=RERUN Admin

# Gmail SMTP (App Password method)
# 1. Enable 2FA on your Google account
# 2. Go to myaccount.google.com → Security → App passwords
# 3. Generate a 16-char App Password for "Mail"
GMAIL_ADDRESS=noreply@rerun.health
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=RERUN Health

# Dashboard URL
DASHBOARD_URL=https://dashboard.rerun.health

# App Config
ENVIRONMENT=development
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com